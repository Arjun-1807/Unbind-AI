# Google Identity Services client id. Public by design — it identifies the app
# to Google and is visible in the sign-in request either way.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your client id here

# Origin of the FastAPI backend. Feeds BOTH the /api/* rewrite proxy and the
# CSP connect-src in next.config.mjs, and is re-exported as
# NEXT_PUBLIC_BACKEND_ORIGIN for the SSE upload that must bypass the proxy.
#
# Unset, it falls back to https://unbind-backend.vercel.app in production — so a
# local dev server or a preview deploy that forgets this var talks to
# PRODUCTION. Always set it locally.
BACKEND_API_URL=http://localhost:8000

# Canonical public origin of THIS frontend. Every absolute URL in the metadata
# surface derives from it: canonical tags, Open Graph, robots.txt, sitemap.xml.
# Point it at a custom domain once you have one — getting this wrong makes
# search engines index the wrong host.
NEXT_PUBLIC_SITE_URL=https://unbindai.vercel.app

# ── Core (required) ───────────────────────────────────────────────────────────
PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/unbindai?retryWrites=true&w=majority

# development | production. Defaults to "production" when unset, so a deploy
# that forgets this var fails closed rather than silently relaxing security.
# In production: the auth cookie is Secure + SameSite=None, and startup refuses
# to boot on missing secrets. Set to "development" for local work (non-Secure,
# SameSite=Lax cookie over plain HTTP).
ENVIRONMENT=development

# REQUIRED — no default. The app will not start without it, in any environment.
# Signs session cookies (and, via a derived key, unsubscribe links), so a shared
# or guessable value means anyone can mint a session for any user. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a different value per environment and never commit the real one.
JWT_SECRET=

GROQ_API_KEY=gsk_your-groq-api-key-here
FRONTEND_URL=http://localhost:3000

# ── HyDE (optional) ───────────────────────────────────────────────────────────
# Separate Groq key used ONLY for HyDE (hypothetical document generation during
# retrieval). Using a distinct key means HyDE calls draw on their own per-key
# rate limit instead of sharing GROQ_API_KEY's quota. Falls back to GROQ_API_KEY
# if left unset.
HYDE_KEY=gsk_your-hyde-groq-api-key-here

# Separate Groq key used ONLY for the negotiation copilot (drafting negotiation
# messages). Same idea as HYDE_KEY — its own per-key rate limit so drafting
# doesn't eat into the main analysis quota. Falls back to GROQ_API_KEY if unset.
NEGOTIATION_KEY=gsk_your-negotiation-groq-api-key-here

# Separate Groq key used ONLY for vision OCR (reading photographed/scanned
# contracts). Same idea as HYDE_KEY/NEGOTIATION_KEY — its own per-key rate limit.
# Falls back to GROQ_API_KEY if unset. OCR_MODEL must be a vision-capable Groq
# model (verify against Groq's current model list).
GROQ_VISION=gsk_your-vision-groq-api-key-here
OCR_MODEL=qwen/qwen3.6-27b

# Chat / analysis models, by plan tier. Groq retires model IDs on its own
# schedule, and when one goes the whole pipeline 404s — clause extraction,
# summaries, HyDE, negotiation drafts and chat all at once. Overriding these
# here means the fix is a restart, not a deploy. Check what your key can
# actually reach before changing:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#        https://api.groq.com/openai/v1/models
# Do NOT use the groq/compound* models: they can browse the web, which breaks
# the promise that answers come only from the user's document.
CHAT_MODEL_FREE=openai/gpt-oss-120b
CHAT_MODEL_PRO=openai/gpt-oss-120b

# ── Google OAuth (required for "Sign in with Google") ─────────────────────────
GOOGLE_CLIENT_ID=get-this-from-google-developer-console
GOOGLE_CLIENT_SECRET=get-this-from-google-developer-console

# ── Razorpay (required for paid plans on /pricing) ────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys. Use TEST keys
# (rzp_test_…) for development — no real money moves; pay with test cards/UPI
# (e.g. card 4111 1111 1111 1111, any future expiry/CVV; UPI success@razorpay).
# Swap for LIVE keys (rzp_live_…) in production. KEY_ID is public; KEY_SECRET
# is private and must stay server-side.
RAZORPAY_KEY_ID=rzp_test_your-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
# Webhook secret (Razorpay Dashboard → Settings → Webhooks). Point the webhook
# at POST {BACKEND_URL}/api/user/plan/webhook and subscribe to the
# "payment.captured" event. This is the reliable server-to-server confirmation
# that grants the plan even if the browser never returns to call /verify.
# Leave empty to disable the webhook endpoint (it returns 503 when unset).
RAZORPAY_WEBHOOK_SECRET=

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=generate-from-langsmith-dashboard
LANGSMITH_PROJECT="unbind"

# Embeddings run on HuggingFace's hosted Inference API (free). Get a token at
# https://huggingface.co/settings/tokens (a read token is enough).
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxx

# ── Email / SMTP (required for lawyer-contact emails) ─────────────────────────
# SMTP_USER / SMTP_PASSWORD must be set for outbound email to work; if empty,
# email sending is skipped with a warning. For Gmail, SMTP_PASSWORD is an
# App Password (https://support.google.com/accounts/answer/185833), not your login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=UnBind AI

# ── Auth / cookie tunables (optional — sane defaults shown) ───────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
COOKIE_NAME=unbind_token

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Opt-in regex to also allow Vercel preview deployments, e.g.
# VERCEL_PREVIEW_REGEX=https://myproject-.*\.vercel\.app
# Left unset by default so only FRONTEND_URL (and localhost) are allowed.
VERCEL_PREVIEW_REGEX=

# ── Deadline reminders ────────────────────────────────────────────────────────
# Shared secret the scheduler sends as the X-Reminder-Secret header when calling
# POST /api/reminders/sweep. That endpoint emails every user with an upcoming
# deadline, so it must not be callable by anyone who knows the URL. Set the same
# value as the REMINDER_SWEEP_SECRET GitHub Actions repository secret. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty, the sweep endpoint refuses to run (503) rather than defaulting open.
REMINDER_SWEEP_SECRET=

# ── Mongo client tuning ───────────────────────────────────────────────────────
# The driver defaults (100 connections per instance, 30s server selection) assume
# one long-lived process. Under serverless the instance count is elastic, so a
# small per-instance pool is what keeps the cluster's connection limit out of
# reach, and short timeouts make an outage surface as a 503 instead of a hang.
# The defaults below are applied in code; override only if you have a reason.
# MONGO_MAX_POOL_SIZE=10
# MONGO_MAX_IDLE_TIME_MS=30000
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGO_CONNECT_TIMEOUT_MS=5000

# Index creation is a deploy step, not a per-request cost: it used to run on
# every cold start, which meant ten round-trips to Atlas before the first
# request could be served (~11s measured against production). Run it explicitly
# after deploying, and against a brand-new cluster:
#     python -m app.scripts.ensure_indexes
# Set this to true for local development, where no deploy step exists.
RUN_INDEX_CREATION_ON_BOOT=false

# ── Proxy topology ────────────────────────────────────────────────────────────
# How many proxy hops to trust when reading the client IP from X-Forwarded-For.
# Proxies APPEND, so the rightmost entries are the trustworthy ones and the
# leftmost is whatever the client typed. The rate limiter keys on this value:
# set it too high and every limit becomes bypassable with a spoofed header.
# 1 is correct for a single reverse proxy (Vercel's edge). Verify against your
# actual topology before launch.
TRUSTED_PROXY_HOPS=1
